{
  "name": "dsh-vidnote",
  "version": "0.4.5",
  "description": "vid2note for DeepSeek Harness: native view, tools, and UP search for Bilibili videos.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paper-k1te/vid2note.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/paper-k1te/vid2note/tree/main/dsh-plugin",
  "bugs": {
    "url": "https://github.com/paper-k1te/vid2note/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/run": "./lib/run.js",
    "./lib/bili": "./lib/bili.js",
    "./lib/api": "./lib/api.js",
    "./lib/markdown": "./lib/markdown.js",
    "./lib/proxy": "./lib/proxy.js",
    "./lib/admission": "./lib/admission.js",
    "./lib/stt": "./lib/stt.js",
    "./lib/ui": "./lib/ui.js",
    "./lib/window": "./lib/window.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/run.js",
    "lib/bili.js",
    "lib/api.js",
    "lib/markdown.js",
    "lib/proxy.js",
    "lib/admission.js",
    "lib/stt.js",
    "lib/ui.js",
    "lib/window.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bilibili",
    "notes"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
