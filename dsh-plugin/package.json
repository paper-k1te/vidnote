{
  "name": "dsh-vidnote",
  "version": "0.5.1",
  "description": "Bilibili videos to timestamped Markdown: native DSH view, tools, and UP search.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/run": "./lib/run.js",
    "./lib/bili": "./lib/bili.js",
    "./lib/api": "./lib/api.js",
    "./lib/markdown": "./lib/markdown.js",
    "./lib/proxy": "./lib/proxy.js",
    "./lib/ui": "./lib/ui.js",
    "./lib/window": "./lib/window.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/run.js",
    "lib/bili.js",
    "lib/api.js",
    "lib/markdown.js",
    "lib/proxy.js",
    "lib/ui.js",
    "lib/window.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bilibili",
    "notes"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
