{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vid2note",
  "version": "0.4.4",
  "identifier": "com.paperkite.vid2note",
  "build": {
    "frontendDist": "../src/vid2note/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "vid2note",
        "label": "main",
        "width": 1220,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
